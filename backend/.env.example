# ==============================================================================
# Production-Grade RAG Research Assistant - Environment Configuration
# ==============================================================================

# Application
APP_NAME="Production RAG Research Assistant"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# LLM Provider Selection: "gemini" | "openai" | "groq" | "ollama"
LLM_PROVIDER="gemini"

# API Keys (Set whichever provider you are using)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Model Names
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_MODEL="gpt-4o-mini"
GROQ_MODEL="llama-3.3-70b-versatile"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Embedding Model (Runs locally via HuggingFace sentence-transformers by default)
# Options: "sentence-transformers/all-MiniLM-L6-v2", "BAAI/bge-small-en-v1.5", etc.
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"

# Reranker Model
RERANKER_MODEL="ms-marco-MiniLM-L-6-v2"

# Storage Directories (Relative to backend root or absolute)
DATA_DIR="./data"
UPLOAD_DIR="./data/uploads"
QDRANT_STORAGE_PATH="./data/qdrant"
BM25_STORAGE_PATH="./data/bm25"

# RAG & Retrieval Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100
DENSE_TOP_K=15
SPARSE_TOP_K=15
RERANK_TOP_K=5
RRF_K=60
